# Port aplikasi web di server sekolah (default 3000 atau 80)
PORT=3000

# Konfigurasi Database MySQL Server Sekolah
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tugas_sekolah

# Kata sandi login Guru dan Pengawas
GURU_PASSWORD=guru123
PENGAWAS_PASSWORD=pengawas123

# Kunci rahasia untuk tanda tangan HMAC-SHA256 cookie sesi (string acak panjang minimal 32 karakter)
SESSION_SECRET=kunci_rahasia_sekolah_acak_panjang_minimal_32_karakter_abcdef123456789
